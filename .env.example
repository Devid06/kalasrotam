# Copy this file to .env.local and paste in your own values.
# .env.local is git-ignored — these keys never belong in the repository.
#
# Find both in your Supabase dashboard:
#   Project Settings -> API -> Project URL, and the "anon public" key
#
# The anon key is designed to be public and ships in the built JavaScript.
# Safety comes from the Row Level Security policies in supabase/setup.sql,
# not from hiding it.
#
# NEVER put the service_role key here. Anything starting with VITE_ is public.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
